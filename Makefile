COMPOSE := docker compose -f dev/compose.yml
DWH := uv run --locked --project tools/dwh dwh
RUN := $(COMPOSE) run --rm airflow

.PHONY: dev-up dev-down smoke lint fmt image dbt-parse test-integration test-dags e2e test-repo lock dwh-test validate manifest dwh-lint catalog check-standards sql-lint sync-agents sync-agents-check

dev-up:
	$(COMPOSE) up -d trino
	./dev/wait-for-trino.sh

dev-down:
	$(COMPOSE) down -v

smoke:
	./dev/smoke.sh

lint:
	uvx ruff@0.17.3 check .
	uvx ruff@0.17.3 format --check .

sql-lint:
	uvx --python 3.12 sqlfluff==4.5.0 lint dags/dbt/models

fmt:
	uvx ruff@0.17.3 check --fix .
	uvx ruff@0.17.3 format .

image:
	docker build --target dev -t example-dwh-airflow:dev .

dbt-parse:
	$(RUN) 'cd dags/dbt && $$DBT_EXECUTABLE_PATH parse'

test-integration:
	$(RUN) "/opt/dbt-venv/bin/python -m pytest -p no:cacheprovider tests/integration -v"

test-dags:
	$(RUN) "airflow db migrate >/dev/null && python -m pytest -p no:cacheprovider tests/dags -v"

e2e:
	./dev/e2e.sh

test-repo:
	uvx --from pytest==9.2.0 pytest -p no:cacheprovider tests/repo -v

lock:
	docker build --target resolve -t example-dwh-airflow:resolve .
	{ echo '# Generated by `make lock` from requirements.txt (Airflow 3.3.2 constraints). Do not edit.'; \
	  docker run --rm --entrypoint /home/airflow/.local/bin/pip example-dwh-airflow:resolve freeze; } > requirements.lock
	{ echo '# Generated by `make lock` from requirements-dbt.txt. Do not edit.'; \
	  docker run --rm --entrypoint /opt/dbt-venv/bin/pip example-dwh-airflow:resolve freeze; } > requirements-dbt.lock

dwh-test:
	uv run --locked --project tools/dwh pytest -p no:cacheprovider tools/dwh/tests -v

check-standards:
	$(DWH) check-standards --standards docs/standards --require-all

sync-agents:
	$(DWH) sync-agents --repo .

sync-agents-check:
	$(DWH) sync-agents --repo . --check

validate:
	$(DWH) validate --warehouse warehouse

# dbt on the host (no Docker, no Trino): the image's exact versions via requirements-dbt.lock.
HOST_DBT := uvx --python 3.12 --from dbt-core --with-requirements requirements-dbt.lock dbt
HOST_DBT_ENV := DBT_PROFILES_DIR=dags/dbt DBT_PACKAGES_INSTALL_PATH=$(CURDIR)/.dbt/packages \
	DBT_TARGET_PATH=$(CURDIR)/.dbt/target DBT_LOG_PATH=$(CURDIR)/.dbt/logs DBT_SEND_ANONYMOUS_USAGE_STATS=false

manifest:
	$(HOST_DBT_ENV) $(HOST_DBT) deps --project-dir dags/dbt
	$(HOST_DBT_ENV) $(HOST_DBT) parse --project-dir dags/dbt

dwh-lint: manifest
	$(DWH) lint --warehouse warehouse --manifest .dbt/target/manifest.json --project-dir dags/dbt

catalog: manifest
	$(HOST_DBT_ENV) $(HOST_DBT) docs generate --project-dir dags/dbt --no-compile --empty-catalog --static
	$(DWH) catalog --warehouse warehouse --out site --dbt-docs .dbt/target/static_index.html
